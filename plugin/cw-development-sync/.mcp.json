{
  "mcpServers": {
    "cw_development_sync": {
      "command": "node",
      "args": ["./scripts/server.mjs"],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "tools": {
        "cw_publish_snapshot": { "approval_mode": "prompt" },
        "cw_apply_snapshot": { "approval_mode": "prompt" }
      },
      "env_vars": ["LOCALAPPDATA", "USERPROFILE", "COMPUTERNAME", "PATH"],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600
    }
  }
}
