# 复制为 .env 后，分别生成两个不同的随机值：
# openssl rand -hex 32
TOKEN_MONITOR_SECRET=CHANGE_ME
HUB_ADMIN_TOKEN=CHANGE_ME_TOO

# 宿主机仅回环监听；容器内部端口固定为 17321。
HUB_HOST_PORT=17321

# 默认每 5 分钟刷新，缓存 15 分钟后才判定失效。
POLL_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=900

# 128m 是刷新瞬时硬上限，不是常驻内存目标。
MEM_LIMIT=128m
CPU_LIMIT=0.50
PIDS_LIMIT=64

LOG_LEVEL=info
TZ=Asia/Shanghai
